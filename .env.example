# Copy to .env.local and fill in. Never commit .env.local.
# Find these in the Supabase dashboard: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Holds the new-style PUBLISHABLE key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Holds the new-style SECRET key (sb_secret_...). Server only; bypasses row-level security. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Server-only secret used to hash phone numbers and addresses for the free-trial check.
# Must be at least 32 characters: the app refuses to start a request with a shorter one (outside tests).
# Make one with: openssl rand -hex 32   (64 characters)
# Never expose it or commit it. Changing it later invalidates every stored hash.
# `db:seed -- --local` uses this value when set. Only when none is set (CI, throwaway stacks) it falls back to the public local-test-pepper-not-a-secret-0000. NEVER put that constant here or in any hosted/Vercel environment.
HASH_PEPPER=
# Optional, used only by `npm run db:seed`: password for the seeded admin account. Never commit it.
SEED_ADMIN_PASSWORD=
# Required by `npm run db:seed -- --hosted` (not used for --local): passwords for the demo chef and customer accounts.
# At least 12 characters each; choose your own, the defaults in the repo are public. Never commit them.
SEED_DEMO_CHEF_PASSWORD=
SEED_DEMO_CUSTOMER_PASSWORD=

# MOCK API adapter for the auth, phone and address screens. Leave blank to use the real routes
# (the default everywhere). Set to 1 only to run the UI without Supabase; a "MOCK API" badge then shows.
# ALLOW_MOCK_BUILD is only for local production mock builds (next build / next start); never set it on Vercel.
NEXT_PUBLIC_API_MOCK=
